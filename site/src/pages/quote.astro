---
/**
 * Quote request — the single lead entry point for all three tracks.
 *
 * The track is chosen either by the ?track= parameter (so every CTA on the site lands on
 * the right form) or by the visitor picking one. All three forms are rendered and the
 * inactive ones hidden, which keeps this a static page with no JavaScript required to
 * see content — and means a visitor with JS disabled still gets all three forms.
 */
import Base from "~/layouts/Base.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import LeadForm from "~/components/LeadForm.astro";
import { BUSINESS, links, TRACKS } from "~/data/business";

const trail = [{ label: "בקשת הצעת מחיר", href: "/quote/" }];
const tracks = ["private", "contracting", "solar"] as const;
---

{/*
  Resolves the track before the body paints. A deferred script would let the default
  panel render first and then be swapped, which a visitor sees as the form changing shape
  underneath them.
*/}
<Base
  title="הצעת מחיר מחשמלאי ראשי — חשמל, קבלנות וסולארי | RNRG"
  description="בקשת הצעת מחיר לעבודת חשמל בבית, לפרויקט קבלני או לבדיקת התאמה למערכת סולארית. שלושה טפסים נפרדים, רישיון חשמלאי ראשי 991433, פעילות ממצפה רמון ועד עמק חפר."
  breadcrumbs={trail}
>
  <script is:inline>
    (function () {
      var valid = ["private", "contracting", "solar"];
      var t = new URLSearchParams(location.search).get("track");
      document.documentElement.dataset.quoteTrack =
        valid.indexOf(t) > -1 ? t : "private";
    })();
  </script>

  <Breadcrumbs trail={trail} />

  <section class="section quote-intro">
    <div class="container">
      <h1>בקשת הצעת מחיר</h1>
      <p class="lede">
        בחרו את המסלול המתאים. לכל סוג עבודה יש שאלות אחרות — כך נוכל לחזור אליכם עם
        תשובה ולא עם בקשה לעוד פרטים.
      </p>
    </div>
  </section>

  <div class="container quote-layout">
    <div class="track-picker" role="group" aria-label="בחירת סוג פנייה">
      {
        tracks.map((t) => (
          <button
            type="button"
            class="track-picker__btn"
            data-track-btn={t}
            aria-pressed="false"
          >
            {TRACKS[t].label}
          </button>
        ))
      }
    </div>

    <div class="quote-forms">
      {
        tracks.map((t) => (
          <div class="quote-panel" data-track-panel={t}>
            <LeadForm track={t} />
          </div>
        ))
      }
    </div>

    <aside class="quote-aside">
      <h2>מעדיפים לדבר?</h2>
      <p>
        לתקלת חשמל דחופה — שיחה מהירה יותר מכל טופס.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary btn--block" href={links.tel} data-cta-location="quote-aside">
          {BUSINESS.phonePretty}
        </a>
        <a
          class="btn btn--outline btn--block"
          href={links.whatsapp()}
          target="_blank"
          rel="noopener"
          data-cta-location="quote-aside">הודעה בוואטסאפ</a
        >
      </div>

      <dl class="quote-facts">
        <div>
          <dt>רישיון</dt>
          <dd class="mono">{BUSINESS.licenceNumber}</dd>
        </div>
        <div>
          <dt>אזור פעילות</dt>
          <dd>{BUSINESS.areaServed}</dd>
        </div>
        <div>
          <dt>אימייל</dt>
          <dd><a href={links.mailto}>{BUSINESS.email}</a></dd>
        </div>
      </dl>
    </aside>
  </div>
</Base>

<style>
  .quote-intro {
    padding-block: var(--space-6) var(--space-5);
  }
  .quote-intro h1 {
    font-size: var(--step-4);
    margin-block-end: var(--space-4);
  }

  .quote-layout {
    display: grid;
    gap: var(--space-6);
    padding-block-end: var(--section-y);
  }

  /* Always three-up or one-up, never 2+1: auto-fit produced an orphan third button
     across 414px-606px, which reads as a broken segmented control. */
  .track-picker {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    padding: var(--space-2);
    background: var(--bg-sunken);
    border-radius: var(--radius-lg);
    grid-column: 1 / -1;
  }
  .track-picker__btn {
    padding: 0.85rem 1rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-muted);
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .track-picker__btn:hover {
    color: var(--text);
  }
  .track-picker__btn[aria-pressed="true"] {
    background: var(--bg-raised);
    border-color: var(--border);
    color: var(--brand);
    box-shadow: var(--shadow-sm);
  }

  /*
   * Visibility is driven by a root attribute set before the body parses, so the right
   * panel is the one that paints — no swap, no reflow.
   */
  .quote-panel {
    display: none;
  }
  :root[data-quote-track="private"] .quote-panel[data-track-panel="private"],
  :root[data-quote-track="contracting"] .quote-panel[data-track-panel="contracting"],
  :root[data-quote-track="solar"] .quote-panel[data-track-panel="solar"] {
    display: block;
  }
  /* Without JavaScript no attribute is set, so fall back to the shortest form. */
  :root:not([data-quote-track]) .quote-panel[data-track-panel="private"] {
    display: block;
  }

  :root[data-quote-track="private"] .track-picker__btn[data-track-btn="private"],
  :root[data-quote-track="contracting"] .track-picker__btn[data-track-btn="contracting"],
  :root[data-quote-track="solar"] .track-picker__btn[data-track-btn="solar"] {
    background: var(--bg-raised);
    border-color: var(--border);
    color: var(--brand);
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 26rem) {
    .track-picker {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .quote-aside {
    align-self: start;
    padding: var(--space-6);
    background: var(--bg-brand-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .quote-aside h2 {
    font-size: var(--step-1);
    margin-block-end: var(--space-3);
  }
  .quote-aside p {
    color: var(--text-muted);
    font-size: 0.94rem;
    margin-block-end: var(--space-5);
  }
  .quote-aside .btn-row {
    flex-direction: column;
  }

  .quote-facts {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--border-strong);
    font-size: 0.88rem;
  }
  .quote-facts div {
    display: flex;
    gap: var(--space-3);
  }
  .quote-facts dt {
    flex: 0 0 7rem;
    color: var(--text-muted);
  }
  .quote-facts dd {
    margin: 0;
    font-weight: 600;
  }

  @media (min-width: 62rem) {
    .quote-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      gap: var(--space-7);
      align-items: start;
    }
  }
</style>

<script>
  const VALID = ["private", "contracting", "solar"] as const;
  type Track = (typeof VALID)[number];

  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-track-btn]");

  function show(track: Track, pushState = true) {
    document.documentElement.dataset.quoteTrack = track;
    buttons.forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.trackBtn === track))
    );

    if (pushState) {
      const url = new URL(location.href);
      url.searchParams.set("track", track);
      history.replaceState(null, "", url);
    }
    (window as any).rnrgTrack?.("quote_start", { track });
  }

  buttons.forEach((b) =>
    b.addEventListener("click", () => show(b.dataset.trackBtn as Track))
  );

  // The inline head script already chose the track; mirror it onto the buttons without
  // re-writing the URL.
  const chosen = (document.documentElement.dataset.quoteTrack ?? "private") as Track;
  buttons.forEach((b) =>
    b.setAttribute("aria-pressed", String(b.dataset.trackBtn === chosen))
  );
  (window as any).rnrgTrack?.("quote_start", { track: chosen });
</script>
