---
/**
 * Homepage.
 *
 * Replaces the old splash page, which asked visitors to choose "electrical or solar"
 * before telling them whose site they were on, and carried no H1, no body copy and no
 * business name — so the domain root could not rank for anything.
 *
 * The job here is to let three very different audiences self-identify within a few
 * seconds without any of them feeling the site is aimed at somebody else.
 */
import Base from "~/layouts/Base.astro";
import CtaBand from "~/components/CtaBand.astro";
import Testimonials from "~/components/Testimonials.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import Pending from "~/components/Pending.astro";
import { BUSINESS, links } from "~/data/business";
import { featuredProjects, projectStats } from "~/data/projects";
import { PRIMARY_NAV } from "~/data/nav";

const stats = projectStats();
const featured = featuredProjects().slice(0, 3);

/*
 * Contracting first, and rendered differently from the other two.
 *
 * The design review found that three identical cards gave the commercially central line
 * exactly one third of the attention, sitting in the middle where it reads as the middle
 * option. A project manager landing here saw a service menu and classified the business
 * as a domestic electrician.
 *
 * `lead` drives both order and treatment: the contracting card spans the full row, keeps
 * its sub-links, and carries the real conversion CTA. The other two sit beneath it as a
 * pair, shorter, without inner link lists. Nothing is hidden — the private and solar
 * routes are one click away and still in the main navigation — but the page now states a
 * priority instead of presenting a menu.
 */
const tracks = [
  {
    id: "contracting",
    lead: true,
    eyebrow: "לקבלנים, ליזמים ולמנהלי פרויקט",
    title: "קבלנות ביצוע ופרויקטים",
    body:
      "ביצוע חשמל בפרויקט — משלב השלד ועד המסירה. תשתיות, לוחות, תיאום מול בעלי מקצוע " +
      "ועמידה בלוחות הזמנים של האתר.",
    href: "/contracting/",
    cta: "הצעת מחיר לפרויקט",
    ctaHref: "/quote/?track=contracting",
    secondary: "מה אנחנו לוקחים על עצמנו",
    items: PRIMARY_NAV[1].children ?? [],
  },
  {
    id: "private",
    lead: false,
    eyebrow: "לבית ולדירה",
    title: "עבודות חשמל פרטיות",
    body:
      "לוחות חשמל, שדרוג לתלת פאזי, בדיקות ואישורים לביטוח, תאורה, תשתיות ותיקונים — " +
      "בבית קיים, בשיפוץ או בבנייה חדשה.",
    href: "/electrical/",
    cta: "לעבודות חשמל",
    items: PRIMARY_NAV[0].children ?? [],
  },
  {
    id: "solar",
    lead: false,
    eyebrow: "ביתי, מסחרי וקבלני",
    title: "מערכות סולאריות",
    body:
      "תכנון, אספקה והתקנה של מערכות מחוברות רשת ומנותקות רשת, כולל אגירת אנרגיה — " +
      "לבתים, לעסקים ולמבנים חקלאיים.",
    href: "/solar/",
    cta: "למערכות סולאריות",
    items: PRIMARY_NAV[2].children ?? [],
  },
];
---

<Base
  title="חשמלאי ראשי, קבלנות ביצוע ומערכות סולאריות"
  description="RNRG — רוני חג׳ג׳, הנדסאי חשמל ובעל רישיון חשמלאי ראשי. עבודות חשמל לבתים, קבלנות ביצוע לקבלנים וליזמים, ומערכות סולאריות. שירות ממצפה רמון ועד עמק חפר."
>
  <!-- ============================ Hero ============================ -->
  <section class="home-hero">
    <div class="container home-hero__inner">
      <div class="home-hero__body">
        <p class="eyebrow">{BUSINESS.ownerRole}</p>
        {/*
          Was "עבודות חשמל, קבלנות ביצוע ומערכות סולאריות" — a list of three services whose
          first item, and in RTL the first thing the eye meets, was "עבודות חשמל". Readers
          classified the business as a domestic electrician from the first two words. The
          positioning claim leads now, and the other two lines follow it in the lede rather
          than competing with it in the heading.
        */}
        <h1>קבלנות ביצוע חשמל לפרויקטים — ועבודות חשמל ומערכות סולאריות</h1>
        <p class="lede">
          RNRG מבצעת עבודות חשמל לבתים פרטיים, קבלנות ביצוע לפרויקטים מול קבלנים ויזמים,
          והתקנת מערכות סולאריות — הכול תחת רישיון חשמלאי ראשי ובאחריות מלאה.
        </p>

        <div class="btn-row home-hero__actions">
          <a class="btn btn--primary btn--lg" href="/quote/" data-cta="hero-primary" data-cta-location="hero">
            לבקשת הצעת מחיר
          </a>
          <a class="btn btn--outline btn--lg" href={links.tel} data-cta-location="hero">
            חייגו {BUSINESS.phonePretty}
          </a>
        </div>

        <p class="home-hero__note">
          לתקלת חשמל דחופה — עדיף להתקשר. לפרויקט — <a href="/quote/?track=contracting">שלחו את הפרטים</a>
          ונחזור עם התייחסות מקצועית.
        </p>
      </div>

      <div class="home-hero__media">
        <img
          src="/images/gallery/panel-05-wide.jpeg"
          srcset="/images/gallery/panel-05-wide-800w.jpeg 800w, /images/gallery/panel-05-wide.jpeg 1500w"
          sizes="(min-width: 62rem) 48vw, 100vw"
          alt="לוח חשמל מסחרי בן 72 מודולים — הגנות מדורגות, מנתקים ובקרת בידוד"
          width="1500"
          height="1125"
          fetchpriority="high"
          decoding="async"
        />
        <div class="home-hero__card">
          <span class="badge badge--mono">{BUSINESS.licenceLabel}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================== Verified facts ======================== -->
  <section class="section trust-strip">
    <div class="container">
      <ul class="trust-strip__list">
        <li class="stat">
          <span class="stat__value">{stats.count}</span>
          <span class="stat__label">פרויקטים סולאריים מתועדים</span>
        </li>
        <li class="stat">
          {/* bdi so the unit stays to the right of the number in an RTL line. */}
          <span class="stat__value"><bdi>{stats.largestKw} kWp</bdi></span>
          <span class="stat__label">המערכת הגדולה שהותקנה</span>
        </li>
        <li class="stat">
          <span class="stat__value">{stats.locations}</span>
          <span class="stat__label">יישובים שבהם בוצעו עבודות</span>
        </li>
        <li class="stat">
          {/*
            Not the licence number, which was here briefly: a licence has no magnitude,
            so scanned alongside "10" and "22 kWp" it read as the quantity 991,433.
            The licence belongs on the hero badge, where it already is. This is a real
            counted total from the documented projects.
          */}
          <span class="stat__value"><bdi>{Math.round(stats.totalKw)} kWp</bdi></span>
          <span class="stat__label">הספק מותקן מצטבר</span>
        </li>
      </ul>
      <p class="trust-strip__note">
        כל המספרים כאן נספרים מתוך עבודות שבוצעו בפועל ומתועדות באתר.
        <Pending id="fact.experience.years" label="שנות ניסיון — ממתין לנתון" />
      </p>
    </div>
  </section>

  <!-- ========================= Three tracks ========================= -->
  <section class="section section--sunken">
    <div class="container">
      <div class="section-head">
        <h2>שלושה תחומי פעילות, עסק אחד</h2>
        <p>
          עיקר העבודה הוא ביצוע חשמל בפרויקטים מול קבלנים ויזמים. לצידו אנחנו עושים גם
          עבודות חשמל פרטיות ומערכות סולאריות — כל מסלול מוביל למידע ולדרך פנייה שמתאימה
          לסוג העבודה.
        </p>
      </div>

      <div class="tracks">
        {
          tracks.map((track) => (
            <article class:list={["track", { "track--lead": track.lead }]} data-track={track.id}>
              {/*
                Two wrappers so the lead card can become two columns on a wide screen
                without the others changing at all. A full-bleed dark card with copy capped
                at 46ch left half its width empty; the links and the call to action now
                occupy that half instead.
              */}
              <div class="track__copy">
                <p class="eyebrow">{track.eyebrow}</p>
                <h3>{track.title}</h3>
                <p class="track__body">{track.body}</p>
              </div>

              <div class="track__aside">
                {
                  /* Sub-links only on the lead card. On the two smaller cards they added a
                     third of the height for links that already sit in the main navigation,
                     and made all three cards read as equals. */
                  track.lead && (
                    <ul class="track__list">
                      {track.items.slice(0, 5).map((item) => (
                        <li>
                          <a href={item.href}>{item.label}</a>
                        </li>
                      ))}
                    </ul>
                  )
                }
                <div class="track__actions">
                  <a
                    class:list={["btn", track.lead ? "btn--primary" : "btn--outline", "track__cta"]}
                    href={track.ctaHref ?? track.href}
                    data-cta={`track-${track.id}`}
                    data-cta-location="tracks"
                  >
                    {track.cta}
                  </a>
                  {
                    /* The lead card asks for the job; the link to read more sits beside it
                       as a link, not as a second button. The review found this inverted —
                       the heaviest control on the page pointed at another article. */
                    track.lead && track.secondary && (
                      <a class="track__secondary" href={track.href}>
                        {track.secondary}
                      </a>
                    )
                  }
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== Contracting spotlight ===================== -->
  <section class="section section--inverse contracting-band">
    <div class="container contracting-band__inner">
      <div>
        <p class="eyebrow">קבלנות ביצוע</p>
        <h2>עובדים מול קבלנים, יזמים ומנהלי פרויקט</h2>
        <p class="lede">
          פרויקט הוא לא קריאת שירות גדולה. הוא דורש עמידה בלוח זמנים של אתר, תיאום מול
          קבלנים אחרים, עבודה לפי תוכניות, ואיש קשר אחד שאפשר להשיג.
        </p>
        <ul class="contracting-band__points">
          <li>ביצוע משלב השלד ועד המסירה — תשתיות, נקודות, לוחות ובדיקות</li>
          <li>עבודה לפי תוכניות ומול יועץ חשמל</li>
          <li>תיאום מול קבלן ראשי ובעלי מקצוע נוספים באתר</li>
          <li>אחריות על החלק החשמלי בפרויקט, לא רק על הביצוע הנקודתי</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--accent btn--lg" href="/contracting/" data-cta="contracting-band">
            מה אנחנו לוקחים על עצמנו
          </a>
          <a class="btn btn--outline btn--lg" href="/contracting/process/">
            איך עובדים איתנו
          </a>
        </div>
      </div>

      <aside class="contracting-band__aside">
        <h3>מחפשים קבלן חשמל לפרויקט?</h3>
        <p>
          שלחו סוג פרויקט, מיקום, שלב והיקף — ונחזור אליכם עם התייחסות מקצועית ובדיקת
          התאמה. אין צורך בתוכניות בשלב הראשון.
        </p>
        <a class="btn btn--primary btn--block" href="/quote/?track=contracting" data-cta="contracting-aside">
          הצעת מחיר לפרויקט
        </a>
        <p class="contracting-band__small">
          מעדיפים לדבר? <a href={links.tel}>{BUSINESS.phonePretty}</a>
        </p>
      </aside>
    </div>
  </section>

  <!-- ========================== Projects ========================== -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          {/*
            Was "עבודות שבוצעו" — "work we have done" — over three solar installations,
            which presented the solar portfolio as the whole track record. Every documented
            project on this site is solar, so the heading now says so. Naming the limit is
            also the honest way to introduce the contracting gap rather than papering over
            it, and it stops a contractor concluding that solar is all the business does.
          */}
          <h2>פרויקטים סולאריים מתועדים</h2>
          <p>
            כל הפרויקטים שתועדו בזמן אמת הם סולאריים. עבודות החשמל והפרויקטים הקבלניים
            שבוצעו לא צולמו — ולא נמציא אותם.
          </p>
        </div>
        <a class="btn btn--outline" href="/projects/">לכל הפרויקטים</a>
      </div>

      <div class="grid-auto" style="--col: 18rem">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <Testimonials limit={3} />

  <CtaBand track="private" />
</Base>

<style>
  /* ---- Hero ---- */
  .home-hero {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6rem);
    background: linear-gradient(170deg, var(--bg-brand-soft), var(--bg) 70%);
    border-block-end: 1px solid var(--border);
  }
  .home-hero__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .home-hero h1 {
    margin-block-end: var(--space-4);
  }
  .home-hero__actions {
    margin-block-start: var(--space-6);
  }
  .home-hero__note {
    margin-block-start: var(--space-4);
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .home-hero__media {
    position: relative;
  }
  .home-hero__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 62rem) {
    .home-hero__media img {
      /* Taller on desktop so the hero fills the fold rather than floating in it. */
      aspect-ratio: 5 / 4;
    }
  }
  .home-hero__card {
    position: absolute;
    inset-block-end: var(--space-4);
    inset-inline-start: var(--space-4);
  }
  .home-hero__card .badge {
    background: color-mix(in srgb, var(--bg-raised) 94%, transparent);
    backdrop-filter: blur(8px);
    padding: 0.5rem 0.9rem;
  }

  @media (min-width: 62rem) {
    .home-hero__inner {
      /* Was 1.1fr / 0.9fr, which rendered the image at 482px in a 1440px viewport —
         a thumbnail, not a hero. The image is the proof; give it the weight. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: var(--space-8);
      align-items: center;
    }
  }

  /* ---- Trust strip ---- */
  .trust-strip {
    padding-block: var(--space-6);
    border-block-end: 1px solid var(--border);
  }
  .trust-strip__list {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 45%), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .trust-strip__note {
    margin-block-start: var(--space-5);
    font-size: 0.84rem;
    color: var(--text-subtle);
  }

  /* ---- Track cards ---- */
  /*
   * 18rem, not 19rem. Three columns at 19rem need 3x304 + 2x24 = 960px, but the
   * container at a 1024px viewport gives 956.8px — a 3.2px shortfall that dropped the
   * third track card into a half-width orphan row on exactly the most common laptop
   * width. The projects grid above has the same three-up shape and the same fix.
   */
  .tracks {
    display: grid;
    gap: var(--space-5);
    /* Two columns, not auto-fit: the lead card spans both and the remaining pair sits
       beneath it. auto-fit would happily make three equal columns again the moment the
       viewport allowed it, which is the layout this replaces. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 47.9375rem) {
    .tracks {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .track {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    /* The copper rail marks the track; it is the one accent on the card. */
    border-block-start: 3px solid var(--accent);
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .track:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  /* ---- the lead card ---- */
  .track--lead {
    grid-column: 1 / -1;
    background: var(--bg-inverse);
    color: var(--text-on-dark);
    border-color: transparent;
    /* The copper rail is the accent on the light cards. On the dark one it would compete
       with the primary button, so the surface itself carries the emphasis instead. */
    border-block-start-width: 1px;
  }
  .track--lead h3 {
    font-size: var(--step-3);
  }
  .track--lead .eyebrow {
    color: var(--accent-on-dark, var(--accent));
  }
  .track--lead .track__body {
    color: var(--text-on-dark-muted, var(--text-on-dark));
    max-width: 46ch;
  }
  .track--lead .track__list {
    border-block-start-color: var(--border-inverse);
    /* Five links in a single column left a tall thin card; two columns keep the lead card
       close to the height of the pair beneath it. */
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
  }
  .track--lead .track__list a {
    color: var(--text-on-dark-muted, var(--text-on-dark));
  }
  .track--lead .track__list a:hover {
    color: var(--text-on-dark);
  }

  .track__copy {
    display: flex;
    flex-direction: column;
  }
  .track__aside {
    display: flex;
    flex-direction: column;
    /* Pushes the actions to the foot of the card so the two smaller cards line their
       buttons up with each other regardless of body length. */
    margin-block-start: auto;
  }
  .track__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-block-start: auto;
    padding-block-start: var(--space-5);
  }

  /* Two columns on a wide screen: copy on the reading side, links and the call to action
     on the other. Below this width everything stacks, which is what the smaller cards do
     at every width. */
  @media (min-width: 62rem) {
    .track--lead {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: var(--space-7);
      align-items: center;
    }
    .track--lead .track__copy,
    .track--lead .track__aside {
      margin-block-start: 0;
    }
    .track--lead .track__list {
      margin-block-start: 0;
      padding-block-start: 0;
      border-block-start: 0;
      /* One column of five short links reads as a menu and fits the half-width column
         without the 4+1 orphan that a multi-column grid produced here. */
      grid-template-columns: minmax(0, 1fr);
    }
    .track--lead .track__actions {
      margin-block-start: 0;
    }
  }
  .track__secondary {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-on-dark);
  }
  .track__secondary::after {
    /* Leftwards, because the text runs that way. Written as a CSS escape rather than a
       literal arrow so nothing between here and the browser gets to reorder it. */
    content: " \2190";
  }
  .track h3 {
    font-size: var(--step-2);
    margin-block-end: var(--space-3);
  }
  .track__body {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .track__list {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-5) 0;
    padding: 0;
    border-block-start: 1px solid var(--border);
    padding-block-start: var(--space-4);
  }
  .track__list a {
    display: block;
    padding-block: 0.15rem;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--text-muted);
  }
  .track__list a:hover {
    color: var(--brand);
    text-decoration: underline;
  }
  .track__cta {
    /* .track__actions owns the push-to-bottom now. On the two smaller cards the button
       still spans the card, which keeps their footprint identical to each other. */
    flex: 1 1 auto;
    justify-content: center;
  }
  .track--lead .track__cta {
    flex: 0 0 auto;
  }

  /* ---- Contracting band ---- */
  .contracting-band__inner {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }
  .contracting-band__points {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    margin: var(--space-5) 0 var(--space-6);
    padding: 0;
  }
  .contracting-band__points li {
    position: relative;
    padding-inline-start: 1.6rem;
    color: var(--text-on-dark-muted);
    font-size: 0.96rem;
  }
  .contracting-band__points li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.65em;
    width: 0.6rem;
    height: 2px;
    background: var(--copper-500);
  }
  .contracting-band__aside {
    padding: var(--space-6);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-inverse);
    border-radius: var(--radius-lg);
  }
