---
/**
 * Projects index.
 *
 * The old gallery was ten Bootstrap carousels — nine of them wrapping a single image —
 * with the same meaningless alt text on nine of ten photos and no way to filter. The
 * facts underneath were good: customer, town, system type and rated output for every one.
 * This page keeps those facts, makes them filterable, and states plainly what is missing.
 */
import Base from "~/layouts/Base.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import ProjectCard from "~/components/ProjectCard.astro";
import CtaBand from "~/components/CtaBand.astro";
import { PROJECTS, CUSTOMER_TYPE_LABEL, projectStats } from "~/data/projects";
import { BUSINESS, TRACKS } from "~/data/business";

const trail = [{ label: "פרויקטים", href: "/projects/" }];
const stats = projectStats();

const types = Array.from(new Set(PROJECTS.map((p) => p.customerType)));

/** Counted from the data, never typed: the range the grid below actually covers. */
const sizes = PROJECTS.map((p) => p.sizeKw).filter((n): n is number => typeof n === "number");
const smallestKw = Math.min(...sizes);

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "פרויקטים שבוצעו",
  numberOfItems: PROJECTS.length,
  itemListElement: PROJECTS.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: `${p.title}, ${p.location}`,
    url: new URL(`/projects/${p.slug}/`, BUSINESS.siteUrl).href,
  })),
};
---

{/*
  The title used to promise "לוחות, תשתיות ומערכות סולאריות". Every one of the ten
  documented projects is solar; a title naming two categories the page does not contain
  sets up the exact disappointment the review recorded.
*/}
<Base
  title="פרויקטים סולאריים שבוצעו — שם, יישוב והספק"
  description="פרויקטים סולאריים שבוצעו בפועל: בתים פרטיים, בניין משותף, גג רפת והאנגר תעשייתי. לכל אחד שם לקוח, יישוב, סוג מערכת והספק המותקן — בלי תמונות מלאי ובלי דוגמאות."
  breadcrumbs={trail}
  schema={[itemListSchema]}
>
  <Breadcrumbs trail={trail} />

  <section class="section projects-head">
    <div class="container">
      <p class="eyebrow">עבודות שבוצעו</p>
      <h1>פרויקטים</h1>
      {/* "והספק" was stated of every project; one of the ten has no recorded output, so
          the count is derived rather than asserted. */}
      <p class="lede">
        כל פרויקט כאן בוצע בפועל, עם שם, מיקום וסוג מערכת. ל־{sizes.length} מתוך {stats.count}
        {" "}רשום גם ההספק. אין כאן תמונות מלאי ואין פרויקטים לדוגמה.
      </p>

      <ul class="projects-stats">
        <li class="stat">
          <span class="stat__value">{stats.count}</span>
          <span class="stat__label">פרויקטים מתועדים</span>
        </li>
        <li class="stat">
          {/* Unrounded — see the note on the homepage stat strip. */}
          <span class="stat__value"><bdi>{stats.totalKw} kWp</bdi></span>
          <span class="stat__label">הספק מותקן מצטבר</span>
        </li>
        <li class="stat">
          <span class="stat__value">{stats.locations}</span>
          <span class="stat__label">יישובים</span>
        </li>
      </ul>
    </div>
  </section>

  {/*
    The contracting band, above the grid rather than in a dashed box at the foot of an
    8000px page.

    The review asked for a table here — units of housing, floor area, connection size,
    role under the main contractor, actual programme, as-made documents. None of those
    numbers exists for a single contracting job (`case.contracting.first`,
    `fact.project.max-scale`), so the table would have to be written from imagination, and
    a fabricated scope table on a portfolio page is the one thing worse than an absent
    one. What is here instead is the same information a project manager actually needs
    from this page: what it does and does not prove, and what to ask for instead.
  */}
  <section class="section section--inverse projects-contracting">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">לקבלנים, יזמים ומנהלי פרויקט</p>
        <h2>בודקים אותנו לפרויקט?</h2>
      </div>
      <div class="projects-contracting__body">
        <p>
          מה שמתועד בעמוד הזה סולארי. עבודות החשמל והפרויקטים הקבלניים שבוצעו לא צולמו בזמן
          אמת, וצילום באתר פעיל הוא ממילא לא תמיד מה שהקבלן הראשי רוצה — לכן הם לא מופיעים
          כאן, ולא נמציא אותם.
        </p>
        <p>
          מה שכן: בשיחה אפשר לעבור על איך אנחנו נכנסים לפרויקט — באילו שלבים, מול מי
          מתבצע התיאום, ומי יהיה איש הקשר שלכם. ומה שנשלח לכם בכתב אפשר להשוות סעיף מול
          סעיף מול הצעות אחרות.
        </p>
        <div class="btn-row">
          <a class="btn btn--accent" href={TRACKS.contracting.href}>מה כולל הביצוע הקבלני</a>
          <a
            class="btn btn--outline"
            href={TRACKS.contracting.quoteHref}
            data-cta-location="projects-contracting">הצעת מחיר לפרויקט</a
          >
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>מערכות סולאריות שבוצעו</h2>
        <p>
          {stats.count} פרויקטים, מ־{smallestKw} ועד {stats.largestKw} קילוואט. אפשר לסנן
          לפי סוג הלקוח:
        </p>
      </div>
      <div class="filters" role="group" aria-label="סינון לפי סוג לקוח">
        <button type="button" class="filter" data-filter="all" aria-pressed="true">הכול</button>
        {
          types.map((t) => (
            <button type="button" class="filter" data-filter={t} aria-pressed="false">
              {CUSTOMER_TYPE_LABEL[t]}
            </button>
          ))
        }
      </div>

      <ul class="projects-grid" id="projects-grid">
        {
          PROJECTS.map((project) => (
            <li data-type={project.customerType}>
              <ProjectCard project={project} featured={project.featured} />
            </li>
          ))
        }
      </ul>

      {/* role="status" so the result count is announced when filters change. */}
      <p class="projects-empty" role="status" aria-live="polite"></p>
    </div>
  </section>

  {/*
    The "מה עוד לא מופיע כאן" panel is gone.

    It was the project's own backlog, rendered in production: a dashed box listing three
    internal tasks with orange P0/P1 chips against them. A business customer checking
    whether this contractor can be trusted with his site read priority codes from someone
    else's sprint. The sentence that mattered — every documented project is solar — is now
    the first paragraph of the contracting band above the grid, where the reader who needs
    it arrives before scrolling ten cards, and it is stated as a fact about the business
    rather than as a ticket.

    case.contracting.first, case.commercial.first and case.details.solar remain open in
    src/data/gaps.ts and are reported in full at /internal/gaps/.
  */}

  <CtaBand track="all" />
</Base>

<style>
  .projects-head {
    padding-block: var(--space-7) var(--space-5);
  }
  .projects-head h1 {
    font-size: var(--step-4);
    margin-block-end: var(--space-4);
  }
  .projects-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
  }

  .projects-contracting .section-head h2 {
    font-size: var(--step-3);
  }
  .projects-contracting__body {
    max-width: var(--measure);
  }
  .projects-contracting__body p + p {
    margin-block-start: var(--space-4);
  }
  .projects-contracting__body .btn-row {
    margin-block-start: var(--space-6);
  }

  /*
   * Sticky on the way down. The mobile page is 8124px of one-column cards and the filter
   * row — the only control that shortens it — used to scroll out of reach after the first
   * card. It is the whole navigation of this page, so it stays.
   */
  .filters {
    position: sticky;
    top: var(--header-h);
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-end: var(--space-6);
    padding-block: var(--space-3);
    background: var(--bg);
  }
  .filter {
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    /* Named properties, not `all`: the latter animates layout-affecting properties
       too, and this was the only `transition: all` left in the codebase. */
    transition: background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .filter:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .filter[aria-pressed="true"] {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--brand-contrast);
  }

  .projects-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .projects-grid li[hidden] {
    display: none;
  }
  .projects-empty {
    margin-block-start: var(--space-6);
    color: var(--text-muted);
  }
  .projects-empty:empty {
    display: none;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter");
  const items = document.querySelectorAll<HTMLElement>("#projects-grid > li");
  const empty = document.querySelector<HTMLElement>(".projects-empty");

  buttons.forEach((btn) =>
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));

      let visible = 0;
      items.forEach((li) => {
        const show = filter === "all" || li.dataset.type === filter;
        li.hidden = !show;
        if (show) visible++;
      });

      // Announce the outcome. Writing text rather than toggling `hidden` keeps the live
      // region in the accessibility tree, which is what makes the announcement happen.
      if (empty) {
        empty.textContent =
          visible === 0
            ? "אין פרויקטים בקטגוריה הזו."
            : `מוצגים ${visible} פרויקטים.`;
      }
    })
  );
</script>
