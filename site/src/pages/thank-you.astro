---
/**
 * Confirmation page.
 *
 * Noindex — it has no search value and must never be a landing page. It shows the lead id
 * so the visitor has a reference, states what happens next, and fires the conversion event
 * as a backstop in case the visitor navigated here directly.
 */
import Base from "~/layouts/Base.astro";
import { BUSINESS, links } from "~/data/business";
---

<Base
  title="הפנייה התקבלה"
  description="הפנייה שלכם התקבלה. נחזור אליכם בהקדם."
  noindex={true}
>
  <section class="section thanks">
    <div class="container container--narrow">
      <div class="thanks__mark" aria-hidden="true">
        <svg viewBox="0 0 48 48" focusable="false">
          <circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="2" opacity="0.3"></circle>
          <path
            d="M15 24.5 21 30.5 33 18"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>

      <h1>הפנייה התקבלה</h1>
      <p class="lede">תודה. נחזור אליכם בהקדם.</p>

      <p class="thanks__ref">
        מספר פנייה: <span class="mono" id="lead-ref">—</span>
      </p>

      <div class="thanks__next">
        <h2>מה קורה עכשיו</h2>
        <ol>
          <li>הפנייה נקלטה אצלנו עם כל הפרטים ששלחתם.</li>
          <li>נעבור עליה ונחזור אליכם — בטלפון או במייל, לפי מה שהשארתם.</li>
          <li>אם משהו לא ברור או חסר, נשאל לפני שנשלח הצעה, ולא אחרי.</li>
        </ol>
      </div>

      <div class="thanks__urgent">
        <h2>דחוף?</h2>
        <p>אם מדובר בתקלת חשמל שלא סובלת דיחוי, עדיף להתקשר.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={links.tel} data-cta-location="thank-you">
            {BUSINESS.phonePretty}
          </a>
          <a
            class="btn btn--outline"
            href={links.whatsapp()}
            target="_blank"
            rel="noopener"
            data-cta-location="thank-you">וואטסאפ</a
          >
        </div>
      </div>

      <p class="thanks__back">
        בינתיים אפשר לראות <a href="/projects/">עבודות שבוצענו</a> או
        <a href="/faq/">שאלות נפוצות</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .thanks {
    padding-block: var(--space-8);
    text-align: center;
  }
  .thanks__mark {
    color: var(--success);
    display: grid;
    place-items: center;
    margin-block-end: var(--space-5);
  }
  .thanks__mark svg {
    width: 4rem;
    height: 4rem;
  }
  .thanks h1 {
    font-size: var(--step-4);
    margin-block-end: var(--space-3);
  }
  .thanks .lede {
    margin-inline: auto;
  }
  .thanks__ref {
    margin-block-start: var(--space-4);
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .thanks__next,
  .thanks__urgent {
    margin-block-start: var(--space-7);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    text-align: start;
  }
  .thanks__next h2,
  .thanks__urgent h2 {
    font-size: var(--step-1);
    margin-block-end: var(--space-4);
  }
  .thanks__next ol {
    padding-inline-start: 1.3em;
    color: var(--text-muted);
    display: grid;
    gap: var(--space-3);
  }
  .thanks__next li::marker {
    color: var(--accent);
    font-weight: 700;
  }
  .thanks__urgent p {
    color: var(--text-muted);
    margin-block-end: var(--space-4);
  }
  .thanks__back {
    margin-block-start: var(--space-6);
    font-size: 0.92rem;
    color: var(--text-muted);
  }
</style>

<script>
  const params = new URLSearchParams(location.search);
  const lead = params.get("lead");
  const ref = document.getElementById("lead-ref");
  if (ref) ref.textContent = lead ?? "—";

  // Backstop conversion event: if the visitor reached this page, the lead exists.
  (window as any).rnrgTrack?.("lead_confirmed", {
    lead_id: lead ?? "",
    via: params.get("via") ?? "form",
  });
</script>
