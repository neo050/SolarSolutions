---
/**
 * About.
 *
 * The old page was a single paragraph with no numbers, no credentials beyond a licence
 * number buried in a landing page, and no photograph of anyone. The origin story —
 * starting with solar systems for caravans in 2018 — is a genuine differentiator and was
 * buried mid-paragraph; here it leads.
 */
import Base from "~/layouts/Base.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import CtaBand from "~/components/CtaBand.astro";
import Pending from "~/components/Pending.astro";
import { SHOW_PENDING } from "~/data/pending";
import { BUSINESS } from "~/data/business";
import { LICENCE_CLASSES, LICENCE_NOTE } from "~/data/regulatory";
import { projectStats } from "~/data/projects";
import { TESTIMONIALS } from "~/data/testimonials";

const trail = [{ label: "אודות", href: "/about/" }];
const stats = projectStats();

/**
 * One review, set as a pull-quote — not the three-card grid.
 *
 * /about/ used <Testimonials limit={3} />, which rendered the first three entries of
 * /reviews/ verbatim: same quotes, same cards, same order. A visitor arriving here from
 * that page read the identical block twice, which is what made the two pages feel like
 * one. Chosen by name rather than by index so re-ordering the data file cannot silently
 * swap it: this is the only review about the person rather than about a solar system,
 * which is the subject of this page.
 */
const pullQuote = TESTIMONIALS.find((t) => t.name === "רז אבישי") ?? TESTIMONIALS[0];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: BUSINESS.owner,
  jobTitle: BUSINESS.ownerRole,
  worksFor: { "@id": `${BUSINESS.siteUrl}/#business` },
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    credentialCategory: "רישיון חשמלאי ראשי",
    identifier: BUSINESS.licenceNumber,
  },
};
---

<Base
  title="רוני חג׳ג׳ — חשמלאי ראשי ודרגות רישיון החשמל"
  description="מי עומד מאחורי RNRG: רוני חג׳ג׳, הנדסאי חשמל ובעל רישיון חשמלאי ראשי 991433. מה כל דרגת רישיון מתירה לתכנן ולבצע, ואיך לאמת רישיון של כל בעל מקצוע."
  breadcrumbs={trail}
  schema={[personSchema]}
>
  <Breadcrumbs trail={trail} />

  <section class="section about-head">
    <div class="container">
      <p class="eyebrow">אודות</p>
      <h1>{BUSINESS.owner}</h1>
      {/*
        Composed rather than `ownerRole · licenceLabel`, which printed "רישיון חשמלאי
        ראשי" twice in the same line — the first thing read on the page whose whole job is
        the credential.
      */}
      <p class="lede">הנדסאי חשמל · חשמלאי ראשי, רישיון {BUSINESS.licenceNumber}</p>
    </div>
  </section>

  <section class="section">
    <div class="container about-layout">
      <div class="prose">
        <h2>איך זה התחיל</h2>
        <p>
          RNRG התחילה בשנת {BUSINESS.solarSince} ממקום לא שגרתי: התקנת מערכות סולאריות
          קטנות לקרוואנים ולרכבים ניידים. זו עבודה שמלמדת דברים שקשה ללמוד אחרת — מערכת
          מנותקת רשת חייבת לעבוד בלי גיבוי, במקום שאין בו טכנאי, ועם כל קילוואט־שעה נחשב.
        </p>
        <p>
          משם ההתרחבות הייתה טבעית: מערכות סולאריות לבתים פרטיים, אחר כך למבנים חקלאיים
          ומסחריים, ובמקביל עבודות החשמל עצמן — לוחות, תשתיות, בדיקות ופרויקטים.
        </p>
        {/*
          Contracting used to get six words inside a list, on the page a main contractor
          opens to decide whether this is a business he can put on his site. It now gets
          the first sentence and the detail — what the work consists of, who it is
          coordinated with — while staying inside what is known: scope of service, not
          track record. No project count, crew size or client name is claimed here.
        */}
        <p>
          היום העסק עובד בשלושה מישורים. ביצוע חשמל בפרויקטים — מול קבלנים, יזמים ומנהלי
          פרויקט, משלב השלד ועד המסירה: תשתיות, נקודות, לוחות ובדיקות, לפי תוכניות ובתיאום
          עם יועץ החשמל ומנהל העבודה באתר. לצידו עבודות חשמל לבתים ולדירות, ומערכות
          סולאריות.
        </p>
        <p>
          את שלושתם מבצע אותו בעל רישיון. זה נשמע טכני, ובפועל זה מה שמונע את השאלה
          שחוזרת בכל עבודה שמחולקת בין גורמים — מי אחראי לחלק שלא עובד.
        </p>

        <h2>מה זה אומר, רישיון חשמלאי ראשי</h2>
        <p>
          דרגת רישיון החשמל אינה תואר כבוד — היא קובעת בדיוק עד איזה גודל חיבור מותר
          לתכנן ולבצע. הרבה בעלי מקצוע כותבים "חשמלאי ראשי" בלי לציין מספר רישיון ובלי
          להסביר מה הדרגה מתירה. המספר שלנו הוא <strong>{BUSINESS.licenceNumber}</strong>.
          אפשר לבדוק אותו מול משרד העבודה — וכדאי לעשות את זה לכל בעל מקצוע שאתם שוקלים,
          לא רק לנו.
        </p>
      </div>

      <aside class="about-facts">
        <h2>עובדות</h2>
        <dl>
          {/* Row removed in production: a definition list term with no definition is
              worse than a shorter list. The gap stays tracked at /internal/gaps/. */}
          {SHOW_PENDING && (
            <div>
              <dt>עוסק בחשמל מאז</dt>
              <dd><Pending id="fact.experience.years" label="ממתין לנתון" /></dd>
            </div>
          )}
          <div>
            <dt>העסק פועל מאז</dt>
            <dd class="mono">{BUSINESS.solarSince}</dd>
          </div>
          <div>
            <dt>רישיון</dt>
            <dd class="mono">{BUSINESS.licenceNumber}</dd>
          </div>
          <div>
            <dt>פרויקטים מתועדים</dt>
            <dd class="mono">{stats.count}</dd>
          </div>
          <div>
            <dt>הספק מותקן מצטבר</dt>
            {/* Unrounded: 85.5 is the counted total across the nine projects that
                record an output. Rounding it to 86 presented an approximation as exact. */}
            <dd class="mono"><bdi>{stats.totalKw} kWp</bdi></dd>
          </div>
          {/*
            A scale figure the page did not have. It answers the "is this business the
            size of my job" question with a counted maximum rather than an estimate, and
            it is derived — not typed — so it cannot drift from projects.ts.
          */}
          <div>
            <dt>המערכת הגדולה ביותר</dt>
            <dd class="mono"><bdi>{stats.largestKw} kWp</bdi></dd>
          </div>
          {SHOW_PENDING && (
            <div>
              <dt>גודל צוות</dt>
              <dd><Pending id="fact.team.size" label="ממתין לנתון" /></dd>
            </div>
          )}
          <div>
            <dt>אזור פעילות</dt>
            <dd>{BUSINESS.areaServed}</dd>
          </div>
        </dl>
        {/*
          Was "מה שעדיין לא ידוע מסומן ככזה" — true of the development build, and false of
          the page a visitor sees, where the unknown rows do not render at all.
        */}
        <p class="about-facts__note">
          כל מספר כאן נספר מעבודות מתועדות. מה שלא ידוע לא מוערך, ולכן לא מופיע.
        </p>
      </aside>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="container">
      <div class="section-head">
        <h2>דרגות רישיון חשמל בישראל</h2>
        <p>
          הטבלה מבוססת על תקנות החשמל (רישיונות), התשמ״ה-1985. שווה לבדוק את הדרגה מול כל
          בעל מקצוע שאתם שוקלים — לא רק מולנו.
        </p>
      </div>
      <div class="table-scroll" tabindex="0" role="region" aria-label="טבלת דרגות רישיון">
        <table class="data-table">
          <thead>
            <tr>
              <th>דרגת רישיון</th>
              <th>מותר לתכנן ולבצע</th>
              <th>עד גודל חיבור</th>
            </tr>
          </thead>
          <tbody>
            {
              LICENCE_CLASSES.map((row) => (
                <tr class:list={{ "is-ours": row.isOurs }}>
                  <td data-label="דרגת רישיון">
                    {row.grade}
                    {row.isOurs && <span class="badge badge--accent">הרישיון שלנו</span>}
                  </td>
                  <td data-label="מותר לתכנן ולבצע">{row.scope}</td>
                  <td class="mono" data-label="עד גודל חיבור">{row.capacity}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="table-source">{LICENCE_NOTE}</p>
    </div>
  </section>

  {/*
    The "הצוות" panel that stood here has been deleted, not hidden.

    It was a working note printed as page copy: it told the visitor that the business
    cannot show him a team, and cited the asset count on the previous site as evidence.
    On the one page whose job is to establish that a real, licensed person is behind the
    work, a panel enumerating what is missing argues the other way — and it argued it in
    the vocabulary of a build report ("78 הנכסים הוויזואליים", "האתר הקודם"), which no
    customer has a reason to read.

    Nothing stops being tracked: photo.owner.portrait, photo.team.onsite and
    fact.credentials.extra are open in src/data/gaps.ts and render in full at
    /internal/gaps/. When a photograph of a person arrives it belongs in the hero, beside
    the origin story — the column the review identified as the right place for it.
  */}

  {/*
    One review, set large, instead of the three-card grid that duplicated /reviews/.
    Different treatment for the same source material, so arriving here from /reviews/ no
    longer reads as the same page twice.
  */}
  <section class="section section--sunken">
    <div class="container">
      <figure class="about-quote">
        <blockquote>{pullQuote.quote}</blockquote>
        <figcaption>
          <strong>{pullQuote.name}</strong>
          <span>{pullQuote.city} · {pullQuote.work}</span>
        </figcaption>
      </figure>
      <p class="about-quote__more">
        <a href="/reviews/">כל ההמלצות, בשם מלא ובישוב</a>
      </p>
    </div>
  </section>

  <CtaBand track="all" />
</Base>

<style>
  .about-head {
    padding-block: var(--space-7) var(--space-4);
  }
  .about-head h1 {
    font-size: var(--step-5);
    margin-block-end: var(--space-3);
  }

  .about-layout {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }
  .about-layout h2 {
    font-size: var(--step-2);
    margin-block-start: var(--space-6);
  }
  .about-layout .prose > h2:first-child {
    margin-block-start: 0;
  }

  .about-facts {
    padding: var(--space-6);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .about-facts h2 {
    font-size: var(--step-1);
    margin-block-end: var(--space-5);
  }
  .about-facts dl {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  .about-facts dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    margin-block-end: 0.25rem;
  }
  .about-facts dd {
    margin: 0;
    font-weight: 600;
  }
  .about-facts__note {
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border);
    font-size: 0.82rem;
    color: var(--text-subtle);
  }

  /* Display-size quote: the page's one break from the site-wide rhythm of
     eyebrow → h2 → body paragraph. */
  .about-quote {
    max-width: 40ch;
    margin: 0;
  }
  .about-quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }
  .about-quote blockquote::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 3px;
    background: var(--accent);
    margin-block-end: var(--space-5);
  }
  .about-quote figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-block-start: var(--space-5);
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .about-quote__more {
    margin-block-start: var(--space-6);
    font-size: 0.9rem;
  }

  @media (min-width: 62rem) {
    .about-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      gap: var(--space-8);
    }
  }
</style>
