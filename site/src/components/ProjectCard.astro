---
import { CUSTOMER_TYPE_LABEL, type Project } from "~/data/projects";

export interface Props {
  project: Project;
  /** Featured cards are larger and lead the grid. */
  featured?: boolean;
}
const { project, featured = false } = Astro.props;
---

<article class:list={["project-card", { "project-card--featured": featured }]}>
  <div class="project-card__media">
    <img
      src={project.image}
      srcset={`${project.image.replace(/(\.[a-z]+)$/, "-800w$1")} 800w, ${project.image} 1800w`}
      sizes="(min-width: 62rem) 30vw, (min-width: 40rem) 45vw, 100vw"
      alt={`${project.title}, ${project.location} — ${project.systemType}${project.sizeKw ? `, ${project.sizeKw} קילוואט` : ""}`}
      width="800"
      height="600"
      loading="lazy"
      decoding="async"
    />
    <span class="badge badge--accent project-card__type">
      {CUSTOMER_TYPE_LABEL[project.customerType]}
    </span>
  </div>

  <div class="project-card__body">
    {/*
      The whole card is the link target, but only the heading holds the anchor — nesting
      anchors would be invalid and would give screen readers two targets for one card.
      The ::after overlay on .project-card__link stretches the hit area to the card.
      Before this, the ten detail pages had no inbound links at all and were orphaned.
    */}
    <h3>
      <a class="project-card__link" href={`/projects/${project.slug}/`}>{project.title}</a>
    </h3>
    <p class="project-card__location">{project.location}</p>
    <p class="project-card__summary">{project.summary}</p>

    <dl class="project-card__specs">
      <div>
        <dt>סוג מערכת</dt>
        <dd>{project.systemType}</dd>
      </div>
      {
        project.sizeKw && (
          <div>
            <dt>הספק</dt>
            <dd class="mono">{project.sizeKw} kWp</dd>
          </div>
        )
      }
    </dl>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .project-card:hover {
    border-color: var(--brand);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .project-card:focus-within {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .project-card__link {
    color: inherit;
    text-decoration: none;
  }
  /* Stretches the heading anchor over the whole card without nesting anchors. */
  .project-card__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .project-card__link:focus-visible {
    outline: none;
  }
  .project-card:hover .project-card__link {
    color: var(--brand);
  }

  .project-card__media {
    position: relative;
    background: var(--bg-sunken);
  }
  .project-card__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .project-card--featured .project-card__media img {
    aspect-ratio: 16 / 10;
  }
  .project-card__type {
    position: absolute;
    inset-block-start: var(--space-3);
    inset-inline-start: var(--space-3);
    background: color-mix(in srgb, var(--bg-raised) 92%, transparent);
    backdrop-filter: blur(6px);
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    flex: 1 1 auto;
  }
  .project-card h3 {
    font-size: var(--step-1);
  }
  .project-card__location {
    font-size: 0.86rem;
    color: var(--accent);
    font-weight: 600;
  }
  .project-card__summary {
    color: var(--text-muted);
    font-size: 0.94rem;
  }

  .project-card__specs {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    margin-block-start: auto;
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border);
  }
  .project-card__specs div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: 0.86rem;
  }
  .project-card__specs dt {
    color: var(--text-subtle);
  }
  .project-card__specs dd {
    margin: 0;
    font-weight: 600;
    text-align: end;
  }
</style>
