---
import { PRIMARY_NAV, SECONDARY_NAV, isActive } from "~/data/nav";
import { BUSINESS, links } from "~/data/business";
import type { Track } from "~/data/business";

export interface Props {
  track?: Track;
}
const { track } = Astro.props;
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__bar container">
    <a class="brand" href="/" aria-label={`${BUSINESS.displayName} — לדף הבית`}>
      <svg class="brand__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <rect width="40" height="40" rx="8" fill="var(--panel-900)"></rect>
        <path d="M22 7 12 23h6.5l-2 10 12-18H21l1-8z" fill="var(--copper-500)"></path>
      </svg>
      <span class="brand__text">
        <strong>RNRG</strong>
        <span>רוני חג׳ג׳ · הנדסת חשמל</span>
      </span>
    </a>

    <nav class="nav" aria-label="ניווט ראשי">
      <ul class="nav__list">
        {
          PRIMARY_NAV.map((item) => (
            <li class:list={["nav__item", { "nav__item--has-menu": !!item.children }]}>
              <a
                href={item.href}
                class="nav__link"
                aria-current={isActive(current, item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
              {item.children && (
                <div class="nav__menu">
                  <ul>
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href}>
                          <span class="nav__menu-label">{child.label}</span>
                          {child.blurb && <span class="nav__menu-blurb">{child.blurb}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--ghost btn--sm header-phone" href={links.tel} data-cta-location="header">
        {BUSINESS.phonePretty}
      </a>
      <a
        class="btn btn--primary btn--sm"
        href={track ? `/quote/?track=${track}` : "/quote/"}
        data-cta="quote"
        data-cta-location="header"
      >
        הצעת מחיר
      </a>
    </div>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span class="nav-toggle__box" aria-hidden="true"><span></span></span>
      <span class="visually-hidden">תפריט</span>
    </button>
  </div>

  <!-- Mobile navigation: a <details>-free disclosure driven by one class toggle. -->
  <div class="mobile-nav" id="mobile-nav" hidden>
    <div class="container">
      <nav aria-label="ניווט ראשי — מובייל">
        {
          PRIMARY_NAV.map((item) => (
            <section class="mobile-nav__group">
              <a class="mobile-nav__head" href={item.href}>
                {item.label}
              </a>
              {item.children && (
                <ul>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
        <section class="mobile-nav__group mobile-nav__group--flat">
          <ul>
            {
              SECONDARY_NAV.map((c) => (
                <li>
                  <a href={c.href}>{c.label}</a>
                </li>
              ))
            }
          </ul>
        </section>
      </nav>
      <div class="mobile-nav__actions">
        <a class="btn btn--primary" href={links.tel} data-cta-location="mobile-nav">
          חייגו {BUSINESS.phonePretty}
        </a>
        <a
          class="btn btn--outline"
          href={links.whatsapp()}
          rel="noopener"
          target="_blank"
          data-cta-location="mobile-nav">הודעה בוואטסאפ</a
        >
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--bg-raised) 92%, transparent);
    backdrop-filter: blur(10px);
    border-block-end: 1px solid var(--border);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: var(--header-h);
  }

  /* ---- Brand ---- */
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text);
    flex: 0 0 auto;
  }
  .brand__mark {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
  }
  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand__text strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .brand__text span {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  /* ---- Desktop nav ---- */
  .nav {
    display: none;
    margin-inline-end: auto;
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nav__item {
    position: relative;
  }
  .nav__link {
    display: block;
    padding: var(--space-3) var(--space-3);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .nav__link:hover {
    background: var(--bg-sunken);
    color: var(--brand);
  }
  .nav__link[aria-current="page"] {
    color: var(--brand);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .nav__menu {
    position: absolute;
    inset-block-start: calc(100% + 0.35rem);
    inset-inline-start: 0;
    min-width: 19rem;
    padding: var(--space-2);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.4rem);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease),
      visibility var(--dur);
  }
  /*
   * Opens on hover or focus, but `.is-dismissed` wins so Escape can close a menu without
   * requiring the visitor to move the pointer away — previously there was no way to
   * dismiss one at all, which traps a keyboard user who opened it by tabbing.
   */
  .nav__item--has-menu:not(.is-dismissed):hover .nav__menu,
  .nav__item--has-menu:not(.is-dismissed):focus-within .nav__menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav__menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__menu a {
    display: block;
    padding: var(--space-3);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
  }
  .nav__menu a:hover {
    background: var(--bg-brand-soft);
  }
  .nav__menu-label {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .nav__menu-blurb {
    display: block;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-block-start: 0.1rem;
  }

  /* ---- Actions ---- */
  .site-header__actions {
    display: none;
    align-items: center;
    gap: var(--space-2);
    flex: 0 0 auto;
  }
  .header-phone {
    font-variant-numeric: tabular-nums;
  }

  /* ---- Mobile toggle ---- */
  .nav-toggle {
    margin-inline-start: auto;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
  }
  .nav-toggle__box {
    position: relative;
    display: block;
    width: 1.15rem;
    height: 2px;
  }
  .nav-toggle__box span,
  .nav-toggle__box::before,
  .nav-toggle__box::after {
    position: absolute;
    inset-inline: 0;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: transform var(--dur) var(--ease), opacity var(--dur-fast) var(--ease);
  }
  .nav-toggle__box::before,
  .nav-toggle__box::after {
    content: "";
  }
  .nav-toggle__box span {
    inset-block-start: 0;
  }
  .nav-toggle__box::before {
    inset-block-start: -0.4rem;
  }
  .nav-toggle__box::after {
    inset-block-start: 0.4rem;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__box span {
    opacity: 0;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__box::before {
    transform: translateY(0.4rem) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle__box::after {
    transform: translateY(-0.4rem) rotate(-45deg);
  }

  /* ---- Mobile panel ---- */
  .mobile-nav {
    border-block-start: 1px solid var(--border);
    background: var(--bg-raised);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    padding-block: var(--space-5) var(--space-6);
  }
  .mobile-nav[hidden] {
    display: none;
  }
  .mobile-nav__group + .mobile-nav__group {
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--border);
  }
  .mobile-nav__head {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
    text-decoration: none;
    margin-block-end: var(--space-3);
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .mobile-nav ul a {
    display: block;
    padding: var(--space-3) 0;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .mobile-nav ul a:hover {
    color: var(--brand);
  }
  .mobile-nav__actions {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  @media (min-width: 64rem) {
    .nav,
    .site-header__actions {
      display: flex;
    }
    .nav-toggle,
    .mobile-nav {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const panel = document.getElementById("mobile-nav");

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
      document.documentElement.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });

    // Reset when crossing into the desktop layout, so the scroll lock cannot strand the
    // page with the mobile panel closed but overflow still hidden.
    const mq = window.matchMedia("(min-width: 64rem)");
    mq.addEventListener("change", (e) => e.matches && setOpen(false));
  }

  /*
   * Escape closes an open desktop sub-menu and returns focus to its trigger. The class is
   * cleared as soon as the pointer leaves or focus moves elsewhere, so hover keeps
   * working normally afterwards.
   */
  {
    const items = document.querySelectorAll<HTMLElement>(".nav__item--has-menu");
    items.forEach((item) => {
      const clear = () => item.classList.remove("is-dismissed");
      item.addEventListener("mouseleave", clear);
      item.addEventListener("focusout", (e) => {
        if (!item.contains(e.relatedTarget as Node)) clear();
      });
      item.addEventListener("keydown", (e) => {
        if ((e as KeyboardEvent).key !== "Escape") return;
        item.classList.add("is-dismissed");
        item.querySelector<HTMLAnchorElement>(".nav__link")?.focus();
      });
    });
  }
</script>
