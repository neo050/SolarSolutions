---
/**
 * Lead capture form.
 *
 * Designed around one requirement from the brief: it must not be possible to lose a lead.
 *
 * How that is achieved:
 *   1. Every submission gets a lead id and a timestamp before anything is sent.
 *   2. The payload is written to localStorage FIRST. Nothing leaves the page until the
 *      lead exists locally.
 *   3. POST to the lead endpoint with two retries and backoff.
 *   4. On success the queue entry is cleared and the visitor goes to /thank-you/.
 *   5. On failure the entry stays queued, the visitor sees a real error with working
 *      alternatives, and the queue is retried on the next page load.
 *   6. If no endpoint is configured yet, the form completes via WhatsApp with a fully
 *      formed message rather than silently doing nothing.
 *
 * The old form did none of this: it called window.open on WhatsApp and, if a popup
 * blocker intervened, the visitor saw nothing at all and no record existed anywhere.
 *
 * The endpoint is BLOCKED on gap `integration.lead-endpoint` (a hosting decision).
 */
import { FORMS } from "~/data/forms";
import { BUSINESS, links, TRACKS } from "~/data/business";
import type { Track } from "~/data/business";

export interface Props {
  track: Track;
}
const { track } = Astro.props;
const form = FORMS[track];

const LEAD_ENDPOINT = import.meta.env.PUBLIC_LEAD_ENDPOINT ?? "";

// Cloudflare Turnstile. When the site key is present the widget renders and its token is
// sent with the lead; the server verifies it (functions/api/lead.ts). Absent, the form
// works unchanged — Turnstile is defence in depth on top of the honeypot, server-side
// validation and rate limiting, not a dependency.
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<form
  class="lead-form"
  id={`lead-form-${track}`}
  data-track={track}
  data-event={TRACKS[track].event}
  data-endpoint={LEAD_ENDPOINT}
  data-whatsapp={BUSINESS.whatsapp}
  data-turnstile={TURNSTILE_SITE_KEY}
  novalidate
>
  <div class="lead-form__head">
    <h2>{form.title}</h2>
    <p>{form.lede}</p>
  </div>

  <div class="form-grid">
    {
      form.fields.map((field) => (
        <div class:list={["field", { "field--full": field.full || field.type === "textarea" }]}>
          <label
            class="field__label"
            id={`l-${track}-${field.name}`}
            for={field.type === "radio" ? undefined : `f-${track}-${field.name}`}
          >
            {field.label}
            {field.required && <span class="req" aria-hidden="true">*</span>}
            {field.required && <span class="visually-hidden">(שדה חובה)</span>}
          </label>

          {field.hint && (
            <span class="field__hint" id={`h-${track}-${field.name}`}>
              {field.hint}
            </span>
          )}

          {field.type === "textarea" ? (
            <textarea
              class="textarea"
              id={`f-${track}-${field.name}`}
              name={field.name}
              placeholder={field.placeholder}
              required={field.required}
              aria-describedby={[
                field.hint ? `h-${track}-${field.name}` : null,
                `e-${track}-${field.name}`,
              ]
                .filter(Boolean)
                .join(" ")}
            />
          ) : field.type === "select" ? (
            <select
              class="select"
              id={`f-${track}-${field.name}`}
              name={field.name}
              required={field.required}
              aria-describedby={[
                field.hint ? `h-${track}-${field.name}` : null,
                `e-${track}-${field.name}`,
              ]
                .filter(Boolean)
                .join(" ")}
            >
              <option value="">בחרו…</option>
              {field.options?.map((o) => <option value={o}>{o}</option>)}
            </select>
          ) : field.type === "radio" ? (
            <div
              class="radio-row"
              role="radiogroup"
              aria-labelledby={`l-${track}-${field.name}`}
              aria-describedby={`e-${track}-${field.name}`}
            >
              {field.options?.map((o, i) => (
                <label class="radio">
                  <input
                    type="radio"
                    name={field.name}
                    value={o}
                    required={field.required && i === 0}
                  />
                  <span>{o}</span>
                </label>
              ))}
            </div>
          ) : (
            <input
              class="input"
              id={`f-${track}-${field.name}`}
              name={field.name}
              type={field.type}
              placeholder={field.placeholder}
              required={field.required}
              autocomplete={field.autocomplete}
              inputmode={field.inputmode as any}
              aria-describedby={[
                field.hint ? `h-${track}-${field.name}` : null,
                `e-${track}-${field.name}`,
              ]
                .filter(Boolean)
                .join(" ")}
            />
          )}

          <p class="field__error" id={`e-${track}-${field.name}`} aria-live="polite" />
        </div>
      ))
    }
  </div>

  {/* Honeypot. Positioned off-screen rather than display:none, which bots detect. */}
  <div class="hp-field" aria-hidden="true">
    <label for={`hp-${track}`}>אל תמלאו שדה זה</label>
    <input id={`hp-${track}`} type="text" name="_company_url" tabindex="-1" autocomplete="off" />
  </div>

  {
    TURNSTILE_SITE_KEY && (
      <div class="lead-form__turnstile">
        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="auto" data-language="he" />
      </div>
    )
  }

  <div class="alert alert--error lead-form__alert" role="alert"></div>

  <div class="lead-form__actions">
    <button type="submit" class="btn btn--primary btn--lg">{form.submitLabel}</button>
    <p class="lead-form__reassurance">{form.reassurance}</p>
  </div>

  <p class="lead-form__alt">
    מעדיפים לדבר? <a href={links.tel} data-cta-location="lead-form">{BUSINESS.phonePretty}</a>
    · <a href={links.whatsapp()} target="_blank" rel="noopener" data-cta-location="lead-form">וואטסאפ</a>
  </p>
</form>

{
  TURNSTILE_SITE_KEY && (
    <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js" />
  )
}

<style>
  .lead-form__turnstile {
    margin-block-start: var(--space-5);
  }

  .lead-form {
    padding: var(--space-6);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .lead-form__head {
    margin-block-end: var(--space-6);
  }
  .lead-form__head h2 {
    font-size: var(--step-2);
    margin-block-end: var(--space-3);
  }
  .lead-form__head p {
    color: var(--text-muted);
    max-width: 58ch;
    font-size: 0.96rem;
  }

  .radio-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .radio {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.6rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    cursor: pointer;
    font-size: 0.94rem;
    transition: border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .radio:hover {
    border-color: var(--brand);
  }
  .radio:has(input:checked) {
    border-color: var(--brand);
    background: var(--bg-brand-soft);
    font-weight: 600;
  }
  .radio:has(input:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .lead-form__alert {
    margin-block-start: var(--space-5);
  }

  .lead-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
  }
  .lead-form__reassurance {
    font-size: 0.87rem;
    color: var(--text-muted);
    max-width: 42ch;
    margin: 0;
  }

  .lead-form__alt {
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>

<script>
  interface QueuedLead {
    leadId: string;
    createdAt: string;
    track: string;
    payload: Record<string, unknown>;
    attempts: number;
  }

  const QUEUE_KEY = "rnrg_lead_queue";

  const readQueue = (): QueuedLead[] => {
    try {
      return JSON.parse(localStorage.getItem(QUEUE_KEY) || "[]");
    } catch {
      return [];
    }
  };

  const writeQueue = (q: QueuedLead[]) => {
    try {
      localStorage.setItem(QUEUE_KEY, JSON.stringify(q));
    } catch {
      /* storage full or unavailable — the POST still goes ahead */
    }
  };

  const makeLeadId = () =>
    `L-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`.toUpperCase();

  /** Israeli mobile and landline formats, tolerant of spaces, dashes and +972. */
  const PHONE_RE = /^(\+?972[-\s]?|0)([23489]|5\d|7\d)[-\s]?\d{3}[-\s]?\d{4}$/;
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function validate(formEl: HTMLFormElement): boolean {
    let ok = true;
    let firstBad: HTMLElement | null = null;

    formEl.querySelectorAll<HTMLElement>("[name]").forEach((el) => {
      const input = el as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
      if (input.name.startsWith("_")) return;

      const track = formEl.dataset.track;
      const errEl = formEl.querySelector<HTMLElement>(`#e-${track}-${input.name}`);
      const value = (input.value || "").trim();
      let message = "";

      if (input.required && !value) {
        message = "שדה חובה";
      } else if (value && input.type === "tel" && !PHONE_RE.test(value)) {
        message = "מספר טלפון לא תקין";
      } else if (value && input.type === "email" && !EMAIL_RE.test(value)) {
        message = "כתובת אימייל לא תקינה";
      }

      // Radio groups: at least one in the group must be selected.
      if (input.type === "radio") {
        const group = formEl.querySelectorAll<HTMLInputElement>(`[name="${input.name}"]`);
        const anyChecked = Array.from(group).some((r) => r.checked);
        message = anyChecked ? "" : "יש לבחור אפשרות";
      }

      if (errEl) errEl.textContent = message;
      if (message) {
        ok = false;
        input.setAttribute("aria-invalid", "true");
        if (!firstBad) firstBad = input;
      } else {
        input.removeAttribute("aria-invalid");
      }
    });

    if (firstBad) (firstBad as HTMLElement).focus();
    return ok;
  }

  interface PostResult {
    ok: boolean;
    status: number;
    errorId?: string;
    message?: string;
  }

  /**
   * Posts a lead with bounded retries and a hard timeout.
   *
   * Retries only what is worth retrying: network failures and 5xx. A 4xx means the
   * payload is wrong and will stay wrong, so it returns immediately and the caller
   * surfaces it to the visitor instead of silently looping.
   */
  async function post(endpoint: string, lead: unknown, attempts = 3): Promise<PostResult> {
    let last: PostResult = { ok: false, status: 0 };

    for (let attempt = 0; attempt < attempts; attempt++) {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 10_000);
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(lead),
          signal: controller.signal,
          keepalive: true,
        });
        clearTimeout(timer);

        let payload: any = {};
        try {
          payload = await res.json();
        } catch {
          /* a non-JSON body still leaves res.ok meaningful */
        }

        last = {
          ok: res.ok && payload.ok !== false,
          status: res.status,
          errorId: payload.errorId,
          message: payload.error,
        };

        if (last.ok) return last;
        // Client errors are terminal: the same payload will fail identically.
        if (res.status >= 400 && res.status < 500) return last;
      } catch {
        clearTimeout(timer);
        last = { ok: false, status: 0 }; // network failure or timeout
      }

      if (attempt < attempts - 1) {
        await new Promise((r) => setTimeout(r, 800 * Math.pow(2, attempt)));
      }
    }
    return last;
  }

  function whatsappHandoff(waNumber: string, lead: QueuedLead): string {
    const lines = Object.entries(lead.payload)
      .filter(([k, v]) => v && !k.startsWith("_") && k !== "attribution")
      .map(([k, v]) => `${k}: ${v}`);
    const text = [`פנייה מהאתר (${lead.track})`, `מזהה: ${lead.leadId}`, "", ...lines].join("\n");
    return `https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`;
  }

  document.querySelectorAll<HTMLFormElement>(".lead-form").forEach((formEl) => {
    const alertEl = formEl.querySelector<HTMLElement>(".lead-form__alert")!;
    const submitBtn = formEl.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const track = formEl.dataset.track!;
    const endpoint = formEl.dataset.endpoint || "";
    const waNumber = formEl.dataset.whatsapp!;

    let started = false;
    formEl.addEventListener("focusin", () => {
      if (started) return;
      started = true;
      (window as any).rnrgTrack?.("form_start", { track, form_id: formEl.id });
    });

    // Clear a field's error as soon as the visitor fixes it.
    formEl.addEventListener("input", (e) => {
      const el = e.target as HTMLInputElement;
      if (!el.name || el.getAttribute("aria-invalid") !== "true") return;
      if ((el.value || "").trim()) {
        el.removeAttribute("aria-invalid");
        const err = formEl.querySelector<HTMLElement>(`#e-${track}-${el.name}`);
        if (err) err.textContent = "";
      }
    });

    formEl.addEventListener("submit", async (e) => {
      e.preventDefault();
      alertEl.textContent = "";

      if (!validate(formEl)) {
        alertEl.textContent = "יש למלא את השדות המסומנים.";
        return;
      }

      const data = new FormData(formEl);

      // Honeypot: a filled hidden field means a bot. Behave as if it worked.
      if ((data.get("_company_url") as string)?.trim()) {
        window.location.href = `/thank-you/${track}/`;
        return;
      }

      const payload: Record<string, unknown> = {};
      data.forEach((v, k) => {
        if (!k.startsWith("_")) payload[k] = v;
      });

      const lead: QueuedLead = {
        leadId: makeLeadId(),
        createdAt: new Date().toISOString(),
        track,
        payload: {
          ...payload,
          page: location.pathname,
          attribution: (window as any).rnrgAttribution?.() ?? {},
        },
        attempts: 0,
      };

      // Persist before sending — a lead that reached this line is never lost.
      writeQueue([...readQueue(), lead]);

      submitBtn.dataset.loading = "true";
      submitBtn.disabled = true;

      const eventName = formEl.dataset.event!;
      (window as any).rnrgTrack?.("generate_lead", { track, lead_id: lead.leadId });
      (window as any).rnrgTrack?.(eventName, { track, lead_id: lead.leadId });

      if (!endpoint) {
        // No endpoint configured yet. Hand off to WhatsApp rather than pretending the
        // lead was received — the thank-you page flags this as unconfirmed.
        window.location.href = whatsappHandoff(waNumber, lead);
        setTimeout(() => {
          window.location.href =
            `/thank-you/${track}/?lead=${lead.leadId}&via=whatsapp`;
        }, 1200);
        return;
      }

      // Turnstile, when present. The widget writes its token into a hidden input.
      const tsToken = (formEl.querySelector<HTMLInputElement>(
        '[name="cf-turnstile-response"]'
      )?.value || "").trim();
      if (formEl.dataset.turnstile && !tsToken) {
        submitBtn.dataset.loading = "false";
        submitBtn.disabled = false;
        alertEl.textContent = "אנא השלימו את אימות האבטחה ונסו שוב.";
        return;
      }

      const result = await post(endpoint, { ...lead, turnstileToken: tsToken });

      // Success is the SERVER's decision, never the client's. Only a 2xx after the lead
      // has been durably stored clears the queue and advances to the thank-you page.
      if (result.ok) {
        writeQueue(readQueue().filter((l) => l.leadId !== lead.leadId));
        window.location.href = `/thank-you/${track}/?lead=${lead.leadId}`;
        return;
      }

      submitBtn.dataset.loading = "false";
      submitBtn.disabled = false;
      (window as any).rnrgTrack?.("form_error", {
        track,
        lead_id: lead.leadId,
        status: result.status,
        error_id: result.errorId ?? "",
      });

      // A 4xx means the payload itself is wrong — retrying it unchanged will fail again,
      // so it is dropped from the queue and the visitor is told what to correct.
      const isClientError = result.status >= 400 && result.status < 500 && result.status !== 429;
      if (isClientError) {
        writeQueue(readQueue().filter((l) => l.leadId !== lead.leadId));
        alertEl.innerHTML =
          `לא הצלחנו לקלוט את הפנייה: ${result.message || "אחד הפרטים אינו תקין"}. ` +
          `אנא בדקו את השדות ונסו שוב.` +
          (result.errorId ? ` <span class="mono">${result.errorId}</span>` : "");
      } else {
        alertEl.innerHTML =
          `לא הצלחנו לשלוח את הפנייה כרגע. הפרטים נשמרו והמערכת תנסה שוב אוטומטית. ` +
          `אפשר גם <a href="${whatsappHandoff(waNumber, lead)}" target="_blank" rel="noopener">` +
          `לשלוח בוואטסאפ עכשיו</a>, או להתקשר.` +
          (result.errorId ? ` <span class="mono">${result.errorId}</span>` : "");
      }
    });

    /* ---- Abandonment: started filling, left without submitting ---- */
    let submitted = false;
    formEl.addEventListener("submit", () => {
      submitted = true;
    });
    const reportAbandon = () => {
      if (!started || submitted) return;
      submitted = true; // fire at most once
      const filled = Array.from(new FormData(formEl).entries()).filter(
        ([k, v]) => !k.startsWith("_") && String(v).trim()
      );
      const lastField = filled.length ? filled[filled.length - 1][0] : "";
      (window as any).rnrgTrack?.("form_abandon", {
        track,
        form_id: formEl.id,
        fields_filled: filled.length,
        last_field: lastField,
      });
    };
    // visibilitychange is the reliable signal on mobile; pagehide covers desktop unload.
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") reportAbandon();
    });
    window.addEventListener("pagehide", reportAbandon);
  });

  /* Retry anything left in the queue from a previous visit. */
  (async function flushQueue() {
    const endpoint = document.querySelector<HTMLFormElement>(".lead-form")?.dataset.endpoint;
    if (!endpoint) return;
    const queue = readQueue();
    if (!queue.length) return;

    const remaining: QueuedLead[] = [];
    for (const lead of queue) {
      if (lead.attempts >= 5) {
        // Give up rather than retry forever, but report it so the loss is visible in
        // analytics rather than silent.
        (window as any).rnrgTrack?.("lead_dropped", {
          lead_id: lead.leadId,
          track: lead.track,
          attempts: lead.attempts,
        });
        continue;
      }
      const result = await post(endpoint, lead, 1);
      if (result.ok) {
        (window as any).rnrgTrack?.("lead_recovered", { lead_id: lead.leadId, track: lead.track });
        continue;
      }
      // A terminal client error will never succeed; stop carrying it.
      if (result.status >= 400 && result.status < 500 && result.status !== 429) continue;
      remaining.push({ ...lead, attempts: lead.attempts + 1 });
    }
    writeQueue(remaining);
  })();
</script>
