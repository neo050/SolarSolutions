node_modules/
dist/
.astro/
.env
.env.production
qa-screenshots/

# Generated images awaiting ingest, and the originals ingest preserves. The inbox itself
# is tracked (for its README); what lands in it is not — these are large binaries whose
# ingested copies already live under public/.
asset-inbox/*
!asset-inbox/README.md

# Photographs dropped in for mapping. The folder structure is tracked (it tells the owner
# which category to use); the photographs themselves are not — mapping copies them into
# public/ under ASCII names, and that copy is the one that belongs in the repo.
source-inbox/**/*.jpg
source-inbox/**/*.jpeg
source-inbox/**/*.png
source-inbox/**/*.webp
source-inbox/**/*.heic
source-inbox/**/*.tif
source-inbox/**/*.tiff
