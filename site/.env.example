# Copy to .env and fill in. Both are BLOCKED on the client — see docs/task-board.md.

# Google Tag Manager container. Format: GTM-XXXXXXX
# Until this is set, analytics is inert but every event still queues into dataLayer,
# so supplying the id is the only step needed to start collecting.
PUBLIC_GTM_ID=

# Lead intake endpoint. Requires a host that can run server code — GitHub Pages cannot.
# Until this is set, LeadForm completes via a WhatsApp handoff with a fully formed message.
PUBLIC_LEAD_ENDPOINT=

# Cloudflare Turnstile site key (public half). Optional — the form works without it.
# The secret half is set as a Cloudflare secret named TURNSTILE_SECRET, never here.
PUBLIC_TURNSTILE_SITE_KEY=
